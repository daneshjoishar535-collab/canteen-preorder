          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set(\"adminToken\", j.token);",
                  "pm.test(\"status 2xx\", () => pm.response.to.be.success);"
                ]
              }
            }
