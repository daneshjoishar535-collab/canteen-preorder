# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- Server ----
# 5001, not 5000: on macOS the AirPlay Receiver already uses port 5000
PORT=5001
NODE_ENV=development

# ---- MongoDB Atlas ----
# Atlas -> Connect -> Drivers -> copy the connection string, put your DB user/password and DB name
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/canteen?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Secret code that lets a user register as canteen admin
ADMIN_INVITE_CODE=CANTEEN-ADMIN-2026

# ---- Misc ----
# Comma-separated list of allowed frontend origins ("*" = allow all). No trailing slash.
# In development any http://localhost:<port> is also allowed automatically.
CLIENT_ORIGIN=http://localhost:5173
# Canteen timezone offset used to decide whether a slot has started
CANTEEN_TZ_OFFSET=+05:30
